---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects } from '../projects';
import { site } from '../site';

const featured = await getFeaturedProjects();
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-name">
    {/* Phase 3: the WebGL particle name renders behind this heading. The text stays as real HTML. */}
    <h1 id="hero-name" class="hero__name">{site.name}</h1>
    <p class="hero__tagline">{site.tagline}</p>
  </section>

  <section class="section container" aria-labelledby="selected-work">
    <div class="section-head">
      <h2 id="selected-work" class="eyebrow">Selected work</h2>
      <a href="/work/">All projects</a>
    </div>
    <ul class="work-list" role="list">
      {
        featured.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container intro" aria-labelledby="about-teaser">
    <h2 id="about-teaser" class="eyebrow">About</h2>
    <p class="intro__text">
      PLACEHOLDER. Two sentences about who you are, what you make and what you care about. Keep it
      short; the About page has the full story.
    </p>
    <a href="/about/">More about me</a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-content: end;
    gap: var(--space-4);
    min-height: calc(100svh - 4rem);
    padding-block: var(--space-6);
  }

  .hero__name {
    font-size: var(--text-display);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .hero__tagline {
    max-width: 32rem;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .work-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-6) var(--space-5);
    list-style: none;
    padding: 0;
  }

  .intro {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .intro__text {
    max-width: 48rem;
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
</style>
