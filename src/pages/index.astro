---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmbeddingSpace from '../components/EmbeddingSpace.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects } from '../projects';
import { site } from '../site';

const featured = await getFeaturedProjects();
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-name">
    {/* The particle hero (src/motion/hero) draws this name in particles and hides the text; the text stays for screen readers and as the fallback. */}
    <h1 id="hero-name" class="hero__name" data-reveal="lines">{site.name}</h1>
    <p class="hero__tagline" data-reveal="lines" data-reveal-delay="200">{site.tagline}</p>
  </section>

  <EmbeddingSpace />

  {/* On wide screens with motion on, this section pins and the cards slide sideways (src/motion/effects/horizontal.ts). */}
  <section class="section work" aria-labelledby="selected-work" data-horizontal>
    <div class="container">
      <div class="section-head">
        <h2 id="selected-work" class="eyebrow">Selected work</h2>
        <a href="/work/" data-magnetic>All projects</a>
      </div>
      <ul class="work-list" role="list" data-horizontal-track>
      {
        featured.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))
      }
      </ul>
    </div>
  </section>

  <section class="section container intro" aria-labelledby="about-teaser">
    <h2 id="about-teaser" class="eyebrow">About</h2>
    <p class="intro__text" data-reveal="lines">
      PLACEHOLDER. Two sentences about who you are, what you make and what you care about. Keep it
      short; the About page has the full story.
    </p>
    <a href="/about/" data-magnetic>More about me</a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-content: end;
    gap: var(--space-4);
    min-height: calc(100svh - 4rem);
    padding-block: var(--space-6);
  }

  .hero__name {
    font-size: var(--text-display);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .hero__tagline {
    max-width: 32rem;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .work-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-6) var(--space-5);
    list-style: none;
    padding: 0;
  }

  /* Sideways mode, switched on by the horizontal effect. The section clips at the screen
     edges, so cards slide in from the right edge rather than from the gutter. */
  .work.is-horizontal {
    overflow-x: clip;
  }

  .work.is-horizontal .work-list {
    display: flex;
    gap: var(--space-5);
  }

  .work.is-horizontal .work-list > li {
    flex: 0 0 clamp(24rem, 52vw, 48rem);
  }

  .intro {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .intro__text {
    max-width: 48rem;
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
</style>
