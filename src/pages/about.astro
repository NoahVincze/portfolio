---
import BaseLayout from '../layouts/BaseLayout.astro';

/** PLACEHOLDER entries: newest first. */
const timeline = [
  { years: '2025 – now', title: 'Role, Company', text: 'One line on what you did there.' },
  { years: '2022 – 2025', title: 'Role, Company', text: 'One line on what you did there.' },
  { years: '2019 – 2022', title: 'Studies, School', text: 'One line on what you focused on.' },
];

/** PLACEHOLDER skills. */
const skills = ['Interaction design', 'TypeScript', 'Astro', 'GSAP', 'Three.js', 'GLSL', 'Figma'];
---

<BaseLayout title="About" description="Background, experience and skills.">
  <section class="section container about">
    <h1 class="about__title">About</h1>
    <div class="prose">
      <p>
        PLACEHOLDER. Open with who you are and what you do in one or two sentences. This is the
        line people will remember.
      </p>
      <p>
        Follow with how you got here and what you care about in your work. A short paragraph is
        enough.
      </p>
    </div>
  </section>

  <section class="section container" aria-labelledby="experience">
    <h2 id="experience" class="eyebrow">Experience</h2>
    {/* Phase 4: this timeline draws itself as the visitor scrolls. */}
    <ol class="timeline" role="list">
      {
        timeline.map((entry) => (
          <li class="timeline__item">
            <p class="timeline__years">{entry.years}</p>
            <div>
              <h3 class="timeline__title">{entry.title}</h3>
              <p class="timeline__text">{entry.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container" aria-labelledby="skills">
    <h2 id="skills" class="eyebrow">Skills and tools</h2>
    <ul class="skills" role="list">
      {skills.map((skill) => <li class="skills__chip">{skill}</li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-5);
  }

  .about__title {
    font-size: var(--text-display);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .timeline {
    margin-top: var(--space-5);
    list-style: none;
    padding: 0;
    border-left: 1px solid var(--color-line);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: var(--space-2) var(--space-5);
    padding: 0 0 var(--space-5) var(--space-4);
  }

  .timeline__years {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    padding-top: 0.2em;
  }

  .timeline__title {
    font-size: var(--text-lg);
  }

  .timeline__text {
    color: var(--color-muted);
  }

  @media (max-width: 40rem) {
    .timeline__item {
      grid-template-columns: 1fr;
    }
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
    list-style: none;
    padding: 0;
  }

  .skills__chip {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: 999px;
  }
</style>
