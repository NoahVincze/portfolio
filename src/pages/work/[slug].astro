---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, projectUrl, type Project } from '../../projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, summary, year, role, tags, cover, link, repo } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <div class="progress" data-progress aria-hidden="true"></div>
  <article>
    <header class="project-head container">
      <p class="eyebrow"><a href="/work/">Work</a> / {year}</p>
      <h1 class="project-head__title" data-reveal="lines">{title}</h1>
      <p class="project-head__summary">{summary}</p>
      <dl class="project-head__facts">
        <div>
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt>Year</dt>
          <dd>{year}</dd>
        </div>
        {
          tags.length > 0 && (
            <div>
              <dt>Tags</dt>
              <dd>{tags.join(', ')}</dd>
            </div>
          )
        }
        {
          repo && (
            <div>
              <dt>Code</dt>
              <dd>
                <a href={repo} rel="noopener" target="_blank">
                  GitHub<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </dd>
            </div>
          )
        }
        {
          link && (
            <div>
              <dt>Live</dt>
              <dd>
                <a href={link} rel="noopener" target="_blank">
                  Visit site<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    {/* The card thumbnail morphs into this cover (same transition name). */}
    <div class="container">
      <div
        class="project-cover"
        data-parallax
        data-project-url={projectUrl(project)}
        transition:name={`cover-${project.id}`}
        aria-hidden="true"
      >
        <div data-reveal-media>
          {cover && <img src={cover} alt="" width="1600" height="1200" loading="eager" fetchpriority="high" decoding="async" />}
        </div>
      </div>
    </div>

    <div class="section container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <nav class="section container next" aria-label="Next project">
    <p class="eyebrow">Next project</p>
    <a class="next__link" href={projectUrl(next)} data-reveal="lines">{next.data.title}</a>
  </nav>
</BaseLayout>

<style>
  .project-head {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-5);
  }

  .project-head__title {
    font-size: var(--text-display);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .project-head__summary {
    max-width: 40rem;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .project-head__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .project-head__facts dt {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .project-cover {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
  }

  .next {
    display: grid;
    gap: var(--space-2);
  }

  .next__link {
    display: block;
    width: fit-content;
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
</style>
