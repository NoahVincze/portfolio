---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <section class="section container contact">
    <h1 class="contact__title" data-reveal="lines">Let's talk</h1>
    <p class="contact__lead">
      A question about a project, an idea to build together, or just a hello: write to me, or find me
      on LinkedIn.
    </p>
    {/* The address scrambles on hover and focus; the button copies it (src/motion/effects/contact.ts). */}
    <div class="contact__address">
      <a class="contact__email" href={`mailto:${site.email}`} aria-label={site.email} data-scramble>{site.email}</a>
      <button type="button" class="contact__copy" data-copy={site.email} data-copy-status="#copy-status" data-magnetic="0.2">
        <span class="copy__label">Copy address</span>
      </button>
    </div>
    <p id="copy-status" class="visually-hidden" role="status"></p>
    <ul class="contact__links" role="list">
      {
        site.socials.map((social) => (
          <li>
            <a href={social.href} rel="me noopener" target="_blank">
              {social.label}
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .contact__title {
    font-size: var(--text-display);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .contact__lead {
    max-width: 36rem;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .contact__address {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-4);
  }

  /* Shown from the first paint when JavaScript is on (no layout shift); the effect hides it
     again if the Clipboard API is missing. */
  .contact__copy {
    display: none;
  }

  :global(html[data-motion]) .contact__copy {
    display: inline-flex;
    overflow: hidden;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background: none;
    cursor: pointer;
    font-size: var(--text-sm);
  }

  :global(html[data-motion]) .contact__copy[hidden] {
    display: none;
  }

  .copy__label {
    display: inline-block;
  }

  .contact__email {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .contact__links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }
</style>
