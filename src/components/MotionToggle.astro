---
/**
 * The footer motion switch. Overrides the system reduced-motion setting and is
 * remembered on this device. Logic lives in src/motion/preference.ts.
 */
---

<div class="motion-toggle">
  <button type="button" role="switch" aria-checked="true" class="motion-toggle__button" data-motion-toggle>
    <span class="motion-toggle__label">Animations</span>
    <span class="motion-toggle__track" aria-hidden="true"><span class="motion-toggle__thumb"></span></span>
  </button>
  <span class="motion-toggle__hint" data-motion-hint></span>
</div>

<script>
  import { getSetting, initMotionPreference, isReduced, setSetting } from '../motion/preference';

  initMotionPreference();

  // This script runs once, but the footer is replaced on every client-side navigation.
  // So clicks are handled by one listener on the document, and the switch is re-rendered
  // after each page load.
  function render(): void {
    for (const button of document.querySelectorAll('[data-motion-toggle]')) {
      button.setAttribute('aria-checked', String(!isReduced()));
    }
    for (const hint of document.querySelectorAll('[data-motion-hint]')) {
      hint.textContent = getSetting() === 'system' ? 'Following your system setting' : '';
    }
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-motion-toggle]')) return;
    setSetting(isReduced() ? 'full' : 'reduced');
  });
  window.addEventListener('motion:change', render);
  document.addEventListener('astro:page-load', render);
  render();
</script>

<style>
  .motion-toggle {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .motion-toggle__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .motion-toggle__track {
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--color-muted);
    transition: background-color var(--dur-quick) var(--ease-out);
  }

  .motion-toggle__thumb {
    position: absolute;
    top: 50%;
    left: 0.1875rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-muted);
    transform: translateY(-50%);
    transition:
      transform var(--dur-quick) var(--ease-out),
      background-color var(--dur-quick) var(--ease-out);
  }

  .motion-toggle__button[aria-checked='true'] .motion-toggle__track {
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .motion-toggle__button[aria-checked='true'] .motion-toggle__thumb {
    background: var(--color-bg);
    transform: translate(1rem, -50%);
  }

  .motion-toggle__hint {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
