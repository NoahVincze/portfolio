---
import MotionToggle from './MotionToggle.astro';
import { site } from '../site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  {/* Decorative: runs faster as you scroll (src/motion/effects/marquee.ts). Two identical groups make the loop seamless. */}
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track" data-marquee-track>
      {
        [0, 1].map(() => (
          <div class="marquee__group">
            <span>{site.name}</span>
            <span class="marquee__dot">●</span>
            <span class="marquee__outline">{site.name}</span>
            <span class="marquee__dot">●</span>
          </div>
        ))
      }
    </div>
  </div>
  <div class="container site-footer__inner">
    <div class="site-footer__contact">
      <p class="eyebrow">Get in touch</p>
      <a class="site-footer__email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <div class="site-footer__meta">
      <ul class="site-footer__links">
        {
          site.socials.map((social) => (
            <li>
              <a href={social.href} rel="me noopener" target="_blank" data-magnetic>
                {social.label}
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
      <MotionToggle />
      <p class="site-footer__copy">© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-6) var(--space-5);
  }

  .marquee {
    overflow: hidden;
    margin-bottom: var(--space-6);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee__group {
    display: flex;
    align-items: center;
    gap: 0.3em;
    padding-right: 0.3em;
    font-size: clamp(4rem, 14vw, 13rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .marquee__outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-ink);
  }

  .marquee__dot {
    font-size: 0.22em;
    color: var(--color-accent);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-5);
  }

  .site-footer__email {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    font-size: var(--text-sm);
  }

  .site-footer__links {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .site-footer__copy {
    color: var(--color-muted);
  }
</style>
