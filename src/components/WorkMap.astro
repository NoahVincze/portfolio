---
/**
 * The semantic work map: projects placed by meaning. Each project's embedding (see
 * src/embedding) is projected to 2D with PCA over the projects alone, so neighbours on the
 * map are projects that are about similar things.
 *
 * - Without JavaScript or WebGL: a labelled plot (dots and links).
 * - The work filter re-runs the projection in the browser on just the matching projects,
 *   so the map re-clusters; labels glide to their new places (src/motion/effects/work-map.ts).
 * - With the particle hero running, each project is a cluster of particles and the dots
 *   step aside; clicking a project pulls every particle into it before its page opens.
 */
import { getEmbeddingSpace } from '../embedding';
import { projectForDisplay } from '../embedding/space';
import { getProjects, projectUrl } from '../projects';

const space = await getEmbeddingSpace();
const projects = await getProjects();
const vectors = projects.map((project) => space.projectVectors[`project:${project.id}`] ?? []);
const positions = vectors.every((v) => v.length) ? projectForDisplay(vectors, 2) : projects.map(() => [0, 0]);
const data = {
  ids: projects.map((project) => project.id),
  tags: projects.map((project) => project.data.tags),
  vectors,
};
const percent = (value: number) => `${(50 + value * 40).toFixed(2)}%`;
/** Points right of this (in -1..1) put their label on the left, so it stays on screen. */
const FLIP_AT = 0.2;
---

<div class="work-map" role="region" data-work-map aria-labelledby="work-map-title">
  <div class="work-map__head">
    <h2 id="work-map-title" class="eyebrow">Map</h2>
    <p class="work-map__caption">
      Projects placed by meaning: {space.source === 'model' ? 'all-MiniLM-L6-v2 embeddings' : 'hashed bag-of-words vectors'},
      projected to 2D with PCA. The filter re-runs the projection on the projects it shows.
    </p>
  </div>
  <ul class="work-map__stage" role="list" data-work-map-stage>
    {
      projects.map((project, i) => (
        <li
          class:list={['work-map__point', { 'is-flipped': positions[i]![0]! > FLIP_AT }]}
          data-map-project={project.id}
          style={`--x: ${percent(positions[i]![0]!)}; --y: ${percent(-(positions[i]![1] ?? 0))}`}
        >
          <a href={projectUrl(project)} data-cursor="view" data-map-link>
            <span class="work-map__title">{project.data.title}</span>
            <span class="work-map__year">{project.data.year}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <script type="application/json" data-work-map-data set:html={JSON.stringify(data)} />
</div>

<style>
  .work-map {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .work-map__head {
    display: grid;
    gap: var(--space-2);
    max-width: 36rem;
  }

  .work-map__caption {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .work-map__stage {
    position: relative;
    height: clamp(18rem, 48svh, 30rem);
    list-style: none;
    padding: 0;
    margin: 0;
    border-block: 1px solid var(--color-line);
    /* A safety net: labels pick the side with room (work-map.ts), but never scroll the page. */
    overflow-x: clip;
  }

  .work-map__point {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-0.35rem, calc(-50% + var(--nudge, 0px)));
    transition:
      left var(--dur-cinematic) var(--ease-in-out),
      top var(--dur-cinematic) var(--ease-in-out),
      opacity var(--dur-base) var(--ease-out);
  }

  .work-map__point.is-flipped {
    transform: translate(calc(-100% + 0.35rem), calc(-50% + var(--nudge, 0px)));
  }

  .work-map__point.is-flipped a {
    flex-direction: row-reverse;
  }

  html[data-motion='reduced'] .work-map__point {
    transition: none;
  }

  .work-map__point[hidden] {
    display: block;
    opacity: 0;
    pointer-events: none;
  }

  .work-map__point a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
    text-decoration: none;
  }

  /* The dot; with the particle hero running, the project's cluster of particles replaces it. */
  .work-map__point a::before {
    content: '';
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--color-accent);
    transition: opacity var(--dur-base) var(--ease-out);
  }

  :global(.hero-live) .work-map__point a::before {
    opacity: 0;
  }

  /* Room for the cluster of particles beside the label. */
  :global(.hero-live) .work-map__point a {
    gap: 1.4rem;
  }

  .work-map__title {
    font-weight: 600;
  }

  .work-map__year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media (max-width: 599px) {
    .work-map__year {
      display: none;
    }
  }
</style>
