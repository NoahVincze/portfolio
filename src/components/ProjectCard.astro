---
import { projectUrl, type Project } from '../projects';

interface Props {
  project: Project;
  /** Heading level for the title, so cards fit the page outline. */
  headingLevel?: 'h2' | 'h3';
  /** Load the cover straight away (for a card that is on screen when the page opens). */
  priority?: boolean;
}

const { project, headingLevel: Heading = 'h3', priority = false } = Astro.props;
const { title, summary, year, tags, accent, cover } = project.data;
const url = projectUrl(project);
---

<article class="card">
  <a class="card__link" href={url} data-cursor="view">
    {/* Shares its transition name with the project page cover, so one morphs into the other. */}
    <div
      class="card__cover"
      data-reveal="image"
      data-project-url={url}
      transition:name={`cover-${project.id}`}
      aria-hidden="true"
    >
      <div data-reveal-media style={`--cover: ${accent}`}>
        {
          cover && (
            <img
              src={cover}
              alt=""
              width="1600"
              height="1200"
              loading={priority ? 'eager' : 'lazy'}
              fetchpriority={priority ? 'high' : 'auto'}
              decoding="async"
            />
          )
        }
      </div>
    </div>
    <div class="card__meta">
      <Heading class="card__title">{title}</Heading>
      <span class="card__year">{year}</span>
    </div>
    <p class="card__summary">{summary}</p>
    {tags.length > 0 && <p class="card__tags">{tags.join(' · ')}</p>}
  </a>
</article>

<style>
  .card__link {
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
  }

  .card__cover {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    margin-bottom: var(--space-2);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }

  .card__title {
    font-size: var(--text-lg);
  }

  .card__year,
  .card__tags {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .card__summary {
    color: var(--color-muted);
    max-width: 36rem;
  }

  .card__link:hover .card__title {
    color: var(--color-accent);
  }

  /* Hover: the cover leans in a little. A plain transform on the image, cheap to animate. */
  .card__cover :global(img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }

  :global(html[data-motion='full']) .card__link:is(:hover, :focus-visible) .card__cover :global(img) {
    transform: scale(1.04);
  }
</style>
