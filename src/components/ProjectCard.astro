---
import { projectUrl, type Project } from '../projects';

interface Props {
  project: Project;
  /** Heading level for the title, so cards fit the page outline. */
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, summary, year, tags, accent } = project.data;
---

<article class="card">
  <a class="card__link" href={projectUrl(project)}>
    <div class="card__cover" style={`--cover: ${accent}`} aria-hidden="true"></div>
    <div class="card__meta">
      <Heading class="card__title">{title}</Heading>
      <span class="card__year">{year}</span>
    </div>
    <p class="card__summary">{summary}</p>
    {tags.length > 0 && <p class="card__tags">{tags.join(' · ')}</p>}
  </a>
</article>

<style>
  .card__link {
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
  }

  .card__cover {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--cover);
    margin-bottom: var(--space-2);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }

  .card__title {
    font-size: var(--text-lg);
  }

  .card__year,
  .card__tags {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .card__summary {
    color: var(--color-muted);
    max-width: 36rem;
  }

  .card__link:hover .card__title {
    color: var(--color-accent);
  }
</style>
