---
import { ClientRouter } from 'astro:transitions';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { tokensToCss } from '../motion/tokens';
import { CHART, chartPath, formatEpoch, formatLoss, trainingRun } from '../motion/training';
import { site } from '../site';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Image for link previews when the page is shared (a PNG or JPG in public/, 1200 x 630). */
  image?: string;
}

const { title, description = site.description, image = '/og.png' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
// The site address comes from astro.config.mjs (Vercel's production domain when deployed).
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(image, Astro.site);
const motionTokens = `<style>${tokensToCss()}</style>`;
/** The intro's letters are split here so the CSS animation can start with the first paint. */
const introChars = [...site.name].map((char) => (char === ' ' ? '\u00a0' : char));
/** Each letter crystallises at its own moment (deterministic, so every build matches). */
const charDelays = introChars.map((_, i) => ((i * 7919) % 13) / 12);
/** The intro's training run: curves drawn at build time, numbers ticked by src/motion/intro.ts. */
const run = trainingRun();
const runName = site.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)" />
    {/* Link previews (Open Graph, also read by most chat apps and social networks). */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <Fragment set:html={motionTokens} />
    {/* Client-side navigation with View Transitions. Browsers without them swap instantly. */}
    <ClientRouter fallback="swap" />
    {/*
      Runs before first paint. Sets <html data-motion> (mirrors src/motion/preference.ts) and,
      on a first visit with motion on, <html data-intro="play"> (see src/motion/intro.ts).
    */}
    <script is:inline>
      (function () {
        var stored = null;
        var seen = false;
        try {
          stored = localStorage.getItem('motion-preference');
          seen = Boolean(localStorage.getItem('intro-seen'));
        } catch (e) {
          seen = true;
        }
        var reduced =
          stored === 'reduced' ||
          (stored !== 'full' && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        document.documentElement.dataset.motion = reduced ? 'reduced' : 'full';
        if (!reduced && !seen) document.documentElement.dataset.intro = 'play';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {/* First-visit intro panel (hidden unless <html data-intro="play">): a model trains, then the name crystallises. */}
    <div class="site-intro" aria-hidden="true">
      <div class="container site-intro__inner">
        <div class="site-intro__training">
          <p class="site-intro__run">
            <span>run</span>
            <span class="site-intro__run-name">{runName}</span>
            <span class="site-intro__status">
              <span class="site-intro__status-training">training</span>
              <span class="site-intro__status-done">converged</span>
            </span>
          </p>
          <svg class="site-intro__chart" viewBox={`0 0 ${CHART.width} ${CHART.height}`} role="presentation">
            <line class="site-intro__axis" x1="0" y1={CHART.height - 0.5} x2={CHART.width} y2={CHART.height - 0.5} />
            <path class="site-intro__curve site-intro__curve--val" d={chartPath(run.val)} pathLength="1" />
            <path class="site-intro__curve site-intro__curve--train" d={chartPath(run.train)} pathLength="1" />
          </svg>
          <dl class="site-intro__metrics">
            <div><dt>epoch</dt><dd data-intro-epoch>{formatEpoch(1)}</dd></div>
            <div><dt>loss</dt><dd data-intro-loss>{formatLoss(run.train[0]!)}</dd></div>
            <div><dt>val_loss</dt><dd data-intro-val>{formatLoss(run.val[0]!)}</dd></div>
          </dl>
          <span class="site-intro__progress"></span>
        </div>
        <p class="site-intro__name">
          <span class="site-intro__line">
            {introChars.map((char, i) => <span class="site-intro__char" style={`--d: ${charDelays[i]!.toFixed(3)}`}>{char}</span>)}
          </span>
        </p>
        {/* Invisible copy of the hero tagline, so the name sits exactly where the hero's does. */}
        <p class="site-intro__tagline">{site.tagline}</p>
      </div>
    </div>
    {/* The particle hero. One canvas, kept alive across page navigations. */}
    <canvas class="hero-canvas" transition:persist="hero-canvas" aria-hidden="true"></canvas>
    {/* Custom cursor (mouse and trackpad only). Replaces the system cursor while it shows. */}
    <div class="cursor" transition:persist="cursor" aria-hidden="true">
      <span class="cursor__circle"></span>
      <span class="cursor__label">View</span>
    </div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initMotionPreference } from '../motion/preference';
      import { startMotion } from '../motion/loop';
      import { startPageEffects } from '../motion/page';
      import { startHero } from '../motion/hero';
      import { startCursor } from '../motion/cursor';
      import '../motion/effects';

      initMotionPreference();
      startMotion();
      startPageEffects();
      startHero();
      startCursor();
    </script>
  </body>
</html>
