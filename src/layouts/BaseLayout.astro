---
import { ClientRouter } from 'astro:transitions';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { tokensToCss } from '../motion/tokens';
import { site } from '../site';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const motionTokens = `<style>${tokensToCss()}</style>`;
/** The intro's letters are split here so the CSS animation can start with the first paint. */
const introChars = [...site.name].map((char) => (char === ' ' ? '\u00a0' : char));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Fragment set:html={motionTokens} />
    {/* Client-side navigation with View Transitions. Browsers without them swap instantly. */}
    <ClientRouter fallback="swap" />
    {/*
      Runs before first paint. Sets <html data-motion> (mirrors src/motion/preference.ts) and,
      on a first visit with motion on, <html data-intro="play"> (see src/motion/intro.ts).
    */}
    <script is:inline>
      (function () {
        var stored = null;
        var seen = false;
        try {
          stored = localStorage.getItem('motion-preference');
          seen = Boolean(localStorage.getItem('intro-seen'));
        } catch (e) {
          seen = true;
        }
        var reduced =
          stored === 'reduced' ||
          (stored !== 'full' && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        document.documentElement.dataset.motion = reduced ? 'reduced' : 'full';
        if (!reduced && !seen) document.documentElement.dataset.intro = 'play';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {/* First-visit intro panel (hidden unless <html data-intro="play">). */}
    <div class="site-intro" aria-hidden="true">
      <div class="container site-intro__inner">
        <p class="site-intro__name">
          <span class="site-intro__line">
            {introChars.map((char, i) => <span class="site-intro__char" style={`--i: ${i}`}>{char}</span>)}
          </span>
        </p>
        {/* Invisible copy of the hero tagline, so the name sits exactly where the hero's does. */}
        <p class="site-intro__tagline">{site.tagline}</p>
      </div>
    </div>
    {/* The particle hero. One canvas, kept alive across page navigations. */}
    <canvas class="hero-canvas" transition:persist="hero-canvas" aria-hidden="true"></canvas>
    {/* Custom cursor (mouse and trackpad only). Replaces the system cursor while it shows. */}
    <div class="cursor" transition:persist="cursor" aria-hidden="true">
      <span class="cursor__circle"></span>
      <span class="cursor__label">View</span>
    </div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initMotionPreference } from '../motion/preference';
      import { startMotion } from '../motion/loop';
      import { startPageEffects } from '../motion/page';
      import { startHero } from '../motion/hero';
      import { startCursor } from '../motion/cursor';
      import '../motion/effects';

      initMotionPreference();
      startMotion();
      startPageEffects();
      startHero();
      startCursor();
    </script>
  </body>
</html>
